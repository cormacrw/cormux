{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Harness webview: own commands plus dialog, opener and notification. No shell.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:menu:default",
    "dialog:default",
    "opener:default",
    "notification:default",
    "allow-ipc"
  ]
}
